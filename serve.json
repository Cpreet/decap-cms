{
  "rewrites": [
    { "source": "/img/:file*", "destination": "/static/img/:file*" },
    { "source": "/audio/:file*", "destination": "/static/audio/:file*" },
    { "source": "/transcripts/:file*", "destination": "/static/transcripts/:file*" }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
